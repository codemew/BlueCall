// BlueCall liquid background (AGSL / SkSL runtime shader).
// Four colours flow and fold into each other: two levels of domain-warped
// noise move the colour regions, soft-max blending keeps every colour visible,
// and thin glossy streaks follow the flow so it reads as liquid.

uniform float2 iResolution;
uniform float iTime;
layout(color) uniform half4 c0;
layout(color) uniform half4 c1;
layout(color) uniform half4 c2;
layout(color) uniform half4 c3;

float hash(float2 p) {
    p = fract(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float a = hash(i);
    float b = hash(i + float2(1.0, 0.0));
    float c = hash(i + float2(0.0, 1.0));
    float d = hash(i + float2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float fbm(float2 p) {
    float v = 0.0;
    float a = 0.5;
    float2x2 rot = float2x2(0.80, 0.60, -0.60, 0.80);
    for (int i = 0; i < 3; i++) {
        v += a * noise(p);
        p = rot * p * 2.02 + float2(17.0, 9.0);
        a *= 0.5;
    }
    return v;
}

half4 main(float2 frag) {
    float2 uv = (frag - 0.5 * iResolution) / iResolution.y * 1.3;
    float t = iTime;

    // Large slow warp, then a finer one: big folding currents with small eddies.
    float2 q = float2(fbm(uv * 0.9 + float2(0.0, 0.07 * t)),
                      fbm(uv * 0.9 + float2(5.2, 1.3) - 0.06 * t));
    float2 r = float2(fbm(uv * 1.7 + 2.6 * q + float2(1.7, 9.2) + 0.12 * t),
                      fbm(uv * 1.7 + 2.6 * q + float2(8.3, 2.8) - 0.10 * t));
    float2 w = uv + 1.7 * (q - 0.5) + 0.8 * (r - 0.5);

    // One flowing field per colour; soft-max blending keeps every colour visible.
    float4 n = float4(
        fbm(w * 1.05 + float2( 1.7,  9.2) + float2( 0.10,  0.03) * t),
        fbm(w * 1.05 + float2( 8.3,  2.8) + float2(-0.08,  0.05) * t),
        fbm(w * 1.05 + float2(-4.1,  3.3) + float2( 0.04, -0.09) * t),
        fbm(w * 1.05 + float2( 6.6, -7.7) + float2(-0.05, -0.07) * t));
    float m = max(max(n.x, n.y), max(n.z, n.w));
    float4 k = exp((n - m) * 13.0);
    float sum = k.x + k.y + k.z + k.w;
    float3 col = (k.x * float3(c0.rgb) + k.y * float3(c1.rgb) + k.z * float3(c2.rgb) + k.w * float3(c3.rgb)) / sum;

    // Fine liquid detail: soft shading and thin glossy streaks that follow the flow.
    float d = fbm(w * 2.6 + 1.6 * r);
    col *= 0.84 + 0.30 * d;
    float streak = smoothstep(0.56, 0.60, d) * (1.0 - smoothstep(0.60, 0.68, d));
    col += streak * 0.10;
    // Glossy seams where two colours meet.
    float top = max(max(k.x, k.y), max(k.z, k.w)) / sum;
    col += (1.0 - smoothstep(0.5, 0.85, top)) * 0.07;

    // Gentle vignette, then dither so smooth gradients never band.
    float2 v = frag / iResolution - 0.5;
    col *= 1.0 - 0.30 * dot(v, v);
    col += (hash(frag + fract(t)) - 0.5) / 255.0;
    return half4(half3(clamp(col, 0.0, 1.0)), 1.0);
}
